{
  "manifest_version": 2,
  "id": "maibot-community.affinity-plugin",
  "version": "1.0.0",
  "name": "跨群好感度",
  "description": "跨群共享用户好感度，使用 OpenAI 兼容模型定时结算，并为 Planner 与 Replyer 注入精确身份关系。",
  "author": {
    "name": "VNG",
    "url": "https://github.com/chengxuanchengyu-afk"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/chengxuanchengyu-afk/affinity_plugin",
    "homepage": "https://github.com/chengxuanchengyu-afk/affinity_plugin",
    "documentation": "https://github.com/chengxuanchengyu-afk/affinity_plugin#readme",
    "issues": "https://github.com/chengxuanchengyu-afk/affinity_plugin/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.0.12",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "person.get_id",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
